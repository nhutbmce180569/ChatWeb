@model WebMVC.DTOs.Auth.LoginRequest
@{
    ViewData["Title"] = "Sign In | MessageZ";
    Layout = "_AuthLayout";
}

<div class="auth-card" style="z-index:1;">

    <!-- ── Brand Side ── -->
    <div class="auth-side">
        <div class="auth-side-orb" style="width:280px;height:280px;background:rgba(99,102,241,0.14);top:-80px;left:-60px;"></div>
        <div class="auth-side-orb" style="width:200px;height:200px;background:rgba(34,211,238,0.1);bottom:-50px;right:-40px;"></div>

        <div style="position:relative;z-index:1;">
            <a asp-controller="Home" asp-action="Index" style="display:flex;align-items:center;gap:8px;text-decoration:none;margin-bottom:30px;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <span style="font-weight:800;font-size:1.25rem;letter-spacing:-0.5px;color:var(--text);">MessageZ</span>
            </a>
            <h2 style="font-size:1.85rem;font-weight:900;letter-spacing:-1px;color:var(--text);line-height:1.2;margin-bottom:12px;">
                Welcome back<br>to your <span class="text-grad">workspace.</span>
            </h2>
            <p style="font-size:0.86rem;color:var(--text-3);line-height:1.6;max-width:260px;margin-bottom:0;">
                Connect, collaborate, and communicate at the speed of thought — from any device.
            </p>
        </div>

        <div style="position:relative;z-index:1;display:flex;flex-direction:column;gap:8px;margin-top:auto;padding-top:28px;">
            <div class="trust-item">
                <div class="trust-dot" style="background:var(--green);box-shadow:0 0 8px var(--green);"></div>
                End-to-end encrypted
            </div>
            <div class="trust-item">
                <div class="trust-dot" style="background:var(--primary);box-shadow:0 0 8px var(--primary);"></div>
                Zero data retention
            </div>
            <div class="trust-item">
                <div class="trust-dot" style="background:var(--cyan);box-shadow:0 0 8px var(--cyan);"></div>
                99.9% uptime SLA
            </div>
        </div>
    </div>

    <!-- ── Form Side ── -->
    <div class="auth-form-side">

        <!-- Mobile brand -->
        <div class="d-flex d-md-none align-items-center gap-2 mb-3">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span style="font-weight:800;font-size:1.15rem;color:var(--text);">MessageZ</span>
        </div>

        <div style="margin-bottom:20px;">
            <h3 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.7px;color:var(--text);margin-bottom:4px;">Sign in</h3>
            <p style="font-size:0.85rem;color:var(--text-3);margin-bottom:0;">Enter your credentials to access your account.</p>
        </div>

        <!-- Validation errors -->
        <div asp-validation-summary="ModelOnly" style="display:@(ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty]?.Errors.Count > 0 ? "block" : "none");background:rgba(244,63,94,0.08);border:1px solid rgba(244,63,94,0.22);border-radius:10px;padding:9px 12px;margin-bottom:16px;color:#f87171;font-size:0.8rem;"></div>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate> 

            <!-- Email -->
            <div style="margin-bottom:14px;">
                <label class="field-label" asp-for="Email">Email address</label>
                <input asp-for="Email" class="mz-input" type="email" placeholder="name@company.com" autocomplete="email" />
                <div class="field-error"><span asp-validation-for="Email"></span></div>
            </div>

            <!-- Password -->
            <div style="margin-bottom:20px;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:7px;">
                    <label class="field-label" style="margin-bottom:0;">Password</label>
                    <a href="#" style="font-size:0.75rem;color:var(--primary-2);text-decoration:none;font-weight:500;" tabindex="-1">Forgot?</a>
                </div>
                <div class="input-wrap">
                    <input asp-for="Password" class="mz-input" type="password" id="login-pwd"
                           placeholder="Your password" autocomplete="current-password"
                           style="padding-right:44px !important;" />
                    <button type="button" class="suffix-btn" data-pwd-toggle="login-pwd" aria-label="Show password">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <div class="field-error"><span asp-validation-for="Password"></span></div>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-primary" style="width:100%;justify-content:center;padding:12px;font-size:0.92rem;">
                Sign in to workspace
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
        </form>

        <!-- Divider -->
        <div class="or-divider" style="margin:16px 0;">OR CONTINUE WITH</div>

        <!-- Social (visual) -->
        <div class="d-flex gap-2 mb-3">
            <button class="btn-social" disabled>
                <svg width="16" height="16" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                Google
            </button>
            <button class="btn-social" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                GitHub
            </button>
        </div>

        <p style="text-align:center;font-size:0.85rem;color:var(--text-3);margin:0;">
            No account yet?
            <a asp-action="Register" class="auth-link" style="color:var(--primary-2);font-weight:600;text-decoration:none;margin-left:4px;">Sign up free →</a>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
