@model WebMVC.DTOs.Auth.ForgotPasswordRequest
@{
    ViewData["Title"] = "Forgot Password | MessageZ";
    Layout = "_AuthLayout";
}

<div class="auth-card" style="z-index:1;">

    <!-- ── Brand Side ── -->
    <div class="auth-side">
        <div class="auth-side-orb" style="width:280px;height:280px;background:rgba(99,102,241,0.14);top:-80px;left:-60px;"></div>
        <div class="auth-side-orb" style="width:200px;height:200px;background:rgba(34,211,238,0.1);bottom:-50px;right:-40px;"></div>

        <div style="position:relative;z-index:1;">
            <a asp-controller="Home" asp-action="Index" style="display:flex;align-items:center;gap:8px;text-decoration:none;margin-bottom:30px;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <span style="font-weight:800;font-size:1.25rem;letter-spacing:-0.5px;color:var(--text);">MessageZ</span>
            </a>
            <h2 style="font-size:1.85rem;font-weight:900;letter-spacing:-1px;color:var(--text);line-height:1.2;margin-bottom:12px;">
                Recover your<br><span class="text-grad">account.</span>
            </h2>
            <p style="font-size:0.86rem;color:var(--text-3);line-height:1.6;max-width:260px;margin-bottom:0;">
                Don't worry, it happens to the best of us. We'll send an OTP code directly to your email.
            </p>
        </div>

        <div style="position:relative;z-index:1;display:flex;flex-direction:column;gap:8px;margin-top:auto;padding-top:28px;">
            <div class="trust-item">
                <div class="trust-dot" style="background:var(--primary);box-shadow:0 0 8px var(--primary);"></div>
                Instant OTP Delivery
            </div>
            <div class="trust-item">
                <div class="trust-dot" style="background:var(--green);box-shadow:0 0 8px var(--green);"></div>
                One-Time Secure Code
            </div>
            <div class="trust-item">
                <div class="trust-dot" style="background:var(--cyan);box-shadow:0 0 8px var(--cyan);"></div>
                Protected by MessageZ
            </div>
        </div>
    </div>

    <!-- ── Form Side ── -->
    <div class="auth-form-side">

        <!-- Mobile brand -->
        <div class="d-flex d-md-none align-items-center gap-2 mb-3">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span style="font-weight:800;font-size:1.15rem;color:var(--text);">MessageZ</span>
        </div>

        <div style="margin-bottom:24px;">
            <div style="width:48px;height:48px;border-radius:12px;background:rgba(99,102,241,0.12);display:flex;align-items:center;justify-content:center;margin-bottom:14px;color:var(--primary-2);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            </div>
            <h3 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.7px;color:var(--text);margin-bottom:6px;">Forgot password?</h3>
            <p style="font-size:0.85rem;color:var(--text-3);margin-bottom:0;line-height:1.5;">
                Enter the email address associated with your MessageZ account and we'll send you an OTP to reset your password.
            </p>
        </div>

        <!-- Validation summary -->
        <div asp-validation-summary="ModelOnly" style="display:@(ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty]?.Errors.Count > 0 ? "block" : "none");background:rgba(244,63,94,0.08);border:1px solid rgba(244,63,94,0.22);border-radius:10px;padding:9px 12px;margin-bottom:16px;color:#f87171;font-size:0.8rem;"></div>

        <form asp-action="ForgotPassword" method="post" id="forgot-form" novalidate>

            <!-- Email -->
            <div style="margin-bottom:20px;">
                <label class="field-label" asp-for="Email">Email address</label>
                <div class="input-wrap">
                    <input asp-for="Email" class="mz-input" type="email" placeholder="name@company.com" autocomplete="email" autofocus />
                </div>
                <div class="field-error"><span asp-validation-for="Email"></span></div>
            </div>

            <!-- Submit -->
            <button type="submit" id="btn-submit" class="btn-primary" style="width:100%;justify-content:center;padding:12px;font-size:0.92rem;margin-bottom:16px;">
                <span id="btn-text">Send Verification Code</span>
                <svg id="btn-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                <div id="btn-spinner" class="spinner-border spinner-border-sm d-none" role="status"></div>
            </button>
        </form>

        <p style="text-align:center;font-size:0.85rem;color:var(--text-3);margin:0;">
            Remember your password?
            <a asp-action="Login" class="auth-link" style="color:var(--primary-2);font-weight:600;text-decoration:none;margin-left:4px;">Sign in →</a>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('forgot-form')?.addEventListener('submit', function() {
            if ($(this).valid()) {
                const btn = document.getElementById('btn-submit');
                const text = document.getElementById('btn-text');
                const icon = document.getElementById('btn-icon');
                const spinner = document.getElementById('btn-spinner');
                if (btn) btn.disabled = true;
                if (text) text.textContent = 'Sending OTP...';
                if (icon) icon.classList.add('d-none');
                if (spinner) spinner.classList.remove('d-none');
            }
        });
    </script>
}
