@model WebMVC.DTOs.Auth.ResetPasswordRequest
@{
    ViewData["Title"] = "Reset Password | MessageZ";
    Layout = "_AuthLayout";
}

<div class="auth-card" style="z-index:1;max-width:880px;">

    <!-- ── Brand Side ── -->
    <div class="auth-side">
        <div class="auth-side-orb" style="width:280px;height:280px;background:rgba(99,102,241,0.14);top:-80px;left:-60px;"></div>
        <div class="auth-side-orb" style="width:200px;height:200px;background:rgba(34,211,238,0.1);bottom:-50px;right:-40px;"></div>

        <div style="position:relative;z-index:1;">
            <a asp-controller="Home" asp-action="Index" style="display:flex;align-items:center;gap:8px;text-decoration:none;margin-bottom:30px;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <span style="font-weight:800;font-size:1.25rem;letter-spacing:-0.5px;color:var(--text);">MessageZ</span>
            </a>
            <h2 style="font-size:1.85rem;font-weight:900;letter-spacing:-1px;color:var(--text);line-height:1.2;margin-bottom:12px;">
                Set a new<br><span class="text-grad">password.</span>
            </h2>
            <p style="font-size:0.86rem;color:var(--text-3);line-height:1.6;max-width:260px;margin-bottom:0;">
                Choose a strong and secure password to protect your conversations and account.
            </p>
        </div>

        <div style="position:relative;z-index:1;display:flex;flex-direction:column;gap:8px;margin-top:auto;padding-top:28px;">
            <div class="trust-item">
                <div class="trust-dot" style="background:var(--green);box-shadow:0 0 8px var(--green);"></div>
                BCrypt encrypted
            </div>
            <div class="trust-item">
                <div class="trust-dot" style="background:var(--primary);box-shadow:0 0 8px var(--primary);"></div>
                Auto session sign-out
            </div>
            <div class="trust-item">
                <div class="trust-dot" style="background:var(--cyan);box-shadow:0 0 8px var(--cyan);"></div>
                Anti-replay verification
            </div>
        </div>
    </div>

    <!-- ── Form Side ── -->
    <div class="auth-form-side">

        <!-- Mobile brand -->
        <div class="d-flex d-md-none align-items-center gap-2 mb-3">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span style="font-weight:800;font-size:1.15rem;color:var(--text);">MessageZ</span>
        </div>

        <div style="margin-bottom:20px;">
            <div style="width:48px;height:48px;border-radius:12px;background:rgba(16,185,129,0.12);display:flex;align-items:center;justify-content:center;margin-bottom:14px;color:var(--green);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            </div>
            <h3 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.7px;color:var(--text);margin-bottom:4px;">Reset password</h3>
            <p style="font-size:0.85rem;color:var(--text-3);margin-bottom:0;">
                Enter the OTP code received via email and your new password.
            </p>
        </div>

        <!-- Validation summary -->
        <div asp-validation-summary="ModelOnly" style="display:@(ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty]?.Errors.Count > 0 ? "block" : "none");background:rgba(244,63,94,0.08);border:1px solid rgba(244,63,94,0.22);border-radius:10px;padding:9px 12px;margin-bottom:16px;color:#f87171;font-size:0.8rem;"></div>

        <form asp-action="ResetPassword" method="post" id="reset-form" novalidate>

            <!-- Email -->
            <div style="margin-bottom:14px;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                    <label class="field-label" asp-for="Email" style="margin-bottom:0;">Email address</label>
                    <a asp-action="ForgotPassword" class="auth-link" style="font-size:0.75rem;color:var(--primary-2);text-decoration:none;">Change email</a>
                </div>
                <div class="input-wrap">
                    <input asp-for="Email" class="mz-input" id="email-field" type="email" placeholder="name@company.com" autocomplete="email" />
                </div>
                <div class="field-error"><span asp-validation-for="Email"></span></div>
            </div>

            <!-- OTP Code -->
            <div style="margin-bottom:14px;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                    <label class="field-label" asp-for="Otp" style="margin-bottom:0;">6-Digit OTP Code</label>
                    <button type="button" id="btn-resend-otp" style="background:none;border:none;padding:0;font-size:0.75rem;color:var(--primary-2);font-weight:600;cursor:pointer;">
                        Resend code
                    </button>
                </div>
                <div class="input-wrap">
                    <input asp-for="Otp" class="mz-input" type="text" maxlength="6"
                           placeholder="123456" autocomplete="one-time-code"
                           style="letter-spacing:6px;font-family:Consolas,Monaco,monospace;font-size:1.1rem;font-weight:700;text-align:center;" />
                </div>
                <div class="field-error"><span asp-validation-for="Otp"></span></div>
            </div>

            <!-- New Password -->
            <div style="margin-bottom:14px;">
                <label class="field-label" asp-for="NewPassword">New password</label>
                <div class="input-wrap">
                    <input asp-for="NewPassword" class="mz-input" type="password" id="pwd-field"
                           placeholder="Create new password" autocomplete="new-password"
                           style="padding-right:44px !important;" />
                    <button type="button" class="suffix-btn" data-pwd-toggle="pwd-field" aria-label="Show password">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <!-- Strength bar -->
                <div class="strength-bar" style="margin-top:6px;">
                    <div class="strength-fill" id="strength-fill"></div>
                </div>
                <div style="display:flex;justify-content:space-between;margin-top:5px;">
                    <span id="strength-label" style="font-size:0.72rem;font-weight:600;"></span>
                    <span style="font-size:0.7rem;color:var(--text-3);">Min. 8 chars (uppercase, number, symbol)</span>
                </div>
                <div class="field-error"><span asp-validation-for="NewPassword"></span></div>
            </div>

            <!-- Confirm Password -->
            <div style="margin-bottom:20px;">
                <label class="field-label" asp-for="ConfirmPassword">Confirm new password</label>
                <div class="input-wrap">
                    <input asp-for="ConfirmPassword" class="mz-input" type="password" id="confirm-pwd"
                           placeholder="Repeat new password" autocomplete="new-password"
                           style="padding-right:44px !important;" />
                    <button type="button" class="suffix-btn" data-pwd-toggle="confirm-pwd" aria-label="Show password">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <div class="field-error"><span asp-validation-for="ConfirmPassword"></span></div>
            </div>

            <!-- Submit -->
            <button type="submit" id="btn-reset" class="btn-primary" style="width:100%;justify-content:center;padding:12px;font-size:0.92rem;margin-bottom:16px;">
                <span id="reset-btn-text">Reset Password</span>
                <svg id="reset-btn-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                <div id="reset-btn-spinner" class="spinner-border spinner-border-sm d-none" role="status"></div>
            </button>
        </form>

        <p style="text-align:center;font-size:0.85rem;color:var(--text-3);margin:0;">
            Never mind?
            <a asp-action="Login" class="auth-link" style="color:var(--primary-2);font-weight:600;text-decoration:none;margin-left:4px;">Back to Sign In →</a>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('reset-form')?.addEventListener('submit', function() {
            if ($(this).valid()) {
                const btn = document.getElementById('btn-reset');
                const text = document.getElementById('reset-btn-text');
                const icon = document.getElementById('reset-btn-icon');
                const spinner = document.getElementById('reset-btn-spinner');
                if (btn) btn.disabled = true;
                if (text) text.textContent = 'Updating password...';
                if (icon) icon.classList.add('d-none');
                if (spinner) spinner.classList.remove('d-none');
            }
        });

        // Resend OTP handler with countdown
        const resendBtn = document.getElementById('btn-resend-otp');
        let countdownTimer = null;

        function startCountdown(seconds) {
            if (!resendBtn) return;
            resendBtn.disabled = true;
            let remaining = seconds;
            resendBtn.textContent = `Resend code (${remaining}s)`;
            
            clearInterval(countdownTimer);
            countdownTimer = setInterval(() => {
                remaining--;
                if (remaining <= 0) {
                    clearInterval(countdownTimer);
                    resendBtn.disabled = false;
                    resendBtn.textContent = 'Resend code';
                } else {
                    resendBtn.textContent = `Resend code (${remaining}s)`;
                }
            }, 1000);
        }

        resendBtn?.addEventListener('click', async function() {
            const email = document.getElementById('email-field')?.value?.trim();
            if (!email) {
                if (typeof showToast === 'function') {
                    showToast('Please enter your email address first.', 'error');
                } else {
                    alert('Please enter your email address first.');
                }
                return;
            }

            resendBtn.disabled = true;
            resendBtn.textContent = 'Sending...';

            try {
                const response = await fetch('@Url.Action("ResendOtp", "Auth")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    if (typeof showToast === 'function') {
                        showToast(data.message || 'New OTP sent to your email!', 'success');
                    }
                    startCountdown(60);
                } else {
                    if (typeof showToast === 'function') {
                        showToast(data.message || 'Failed to resend code.', 'error');
                    }
                    resendBtn.disabled = false;
                    resendBtn.textContent = 'Resend code';
                }
            } catch (err) {
                if (typeof showToast === 'function') {
                    showToast('Network error while resending OTP.', 'error');
                }
                resendBtn.disabled = false;
                resendBtn.textContent = 'Resend code';
            }
        });
    </script>
}
