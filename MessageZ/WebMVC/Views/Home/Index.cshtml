@{
    ViewData["Title"] = "Home - Next-Gen Real-time Messaging";
}

<!-- ════════════════ HERO ════════════════ -->
<section class="hero-section">
    <div class="row align-items-center g-4 g-lg-5">

        <!-- Copy -->
        <div class="col-lg-6 text-center text-lg-start">
            <div class="hero-badge mb-3 mb-sm-4">
                <span class="live-dot"></span>
                Real-time · Secure · 2026
            </div>

            <h1 class="hero-h1 mb-3 mb-sm-4">
                Chat at the<br class="d-none d-sm-inline" /> speed of <span class="text-grad">thought.</span>
            </h1>

            <p class="hero-sub mx-auto mx-lg-0 mb-4 mb-sm-5">
                MessageZ is a blazing-fast, end-to-end encrypted messaging platform for teams and communities.
                Zero latency. Maximum clarity.
            </p>

            <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-2 gap-sm-3 mb-4 mb-sm-5">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Chat" asp-action="Index" class="btn-primary w-100 w-sm-auto justify-content-center">
                        Open Chat
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                    <a asp-controller="Profile" asp-action="Index" class="btn-ghost w-100 w-sm-auto justify-content-center" style="display:inline-flex;align-items:center;gap:6px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        My Profile
                    </a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Register" class="btn-primary w-100 w-sm-auto justify-content-center">
                        Start free
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                    <a href="#features" class="btn-ghost w-100 w-sm-auto justify-content-center">Explore features</a>
                }
            </div>

            <!-- Social proof -->
            <div class="d-flex align-items-center justify-content-center justify-content-lg-start gap-3 flex-wrap">
                <div class="avatar-stack">
                    <div class="av" style="background:#6366f1;">A</div>
                    <div class="av" style="background:#22d3ee;z-index:1;">B</div>
                    <div class="av" style="background:#10b981;z-index:2;">C</div>
                    <div class="av" style="background:#f59e0b;z-index:3;">D</div>
                    <div class="av" style="background:#f43f5e;z-index:4;">E</div>
                </div>
                <p class="mb-0 text-center text-sm-start" style="font-size:0.82rem;color:var(--text-3);">
                    Trusted by <strong style="color:var(--text-2);">12,000+</strong> teams worldwide
                </p>
            </div>
        </div>

        <!-- Chat Mockup -->
        <div class="col-lg-6">
            <div class="mockup float mx-auto" style="max-width:480px;">
                <div class="mockup-bar">
                    <div class="mockup-dots">
                        <span style="background:#f43f5e;"></span>
                        <span style="background:#f59e0b;margin:0 5px;"></span>
                        <span style="background:#10b981;"></span>
                    </div>
                    <div class="d-flex align-items-center gap-2 ms-3">
                        <div style="width:22px;height:22px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:700;color:#fff;">D</div>
                        <span style="font-size:0.82rem;font-weight:600;color:var(--text-2);">Design Team</span>
                        <div style="width:6px;height:6px;border-radius:50%;background:#10b981;box-shadow:0 0 6px #10b981;"></div>
                    </div>
                </div>
                <div class="mockup-body">
                    <div style="font-size:0.68rem;color:var(--text-3);text-align:center;margin-bottom:14px;letter-spacing:0.04em;">TODAY · 9:41 AM</div>
                    <div class="mock-bubble in">
                        <span style="font-size:0.7rem;font-weight:600;color:#818cf8;">Sarah</span><br>
                        The new UI mocks are looking incredible 🎉
                    </div>
                    <div class="mock-bubble out">Shipping to production today! Love the aurora gradients 🔥</div>
                    <div class="mock-bubble in">
                        <span style="font-size:0.7rem;font-weight:600;color:#22d3ee;">David</span><br>
                        Dark + Light mode toggle is a game changer 👌
                    </div>
                    <div class="mock-typing">
                        <span></span><span></span><span></span>
                    </div>
                </div>
                <div style="padding:12px 16px;border-top:1px solid var(--border);background:var(--surface-2);display:flex;align-items:center;gap:8px;">
                    <div style="flex:1;background:var(--surface-3);border:1px solid var(--border);border-radius:10px;padding:8px 14px;font-size:0.82rem;color:var(--text-3);">Type a message…</div>
                    <div class="send-btn" style="width:36px;height:36px;border-radius:10px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ════════════════ STATS ════════════════ -->
<section class="stats-section">
    <div class="row g-2 g-sm-3">
        @foreach (var s in new[]{
            ("12K+",  "Active teams"),
            ("<50ms", "Message latency"),
            ("99.9%", "Uptime SLA"),
            ("256-bit","Encryption"),
        }) {
            <div class="col-6 col-md-3">
                <div class="stat-card text-center">
                    <div class="stat-number text-grad">@s.Item1</div>
                    <div class="stat-label">@s.Item2</div>
                </div>
            </div>
        }
    </div>
</section>

<!-- ════════════════ FEATURES BENTO ════════════════ -->
<section id="features" class="features-section" style="padding: 20px 0 60px;">
    <div class="text-center mb-4 mb-sm-5">
        <div class="hero-badge mb-3 d-inline-flex">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            Features
        </div>
        <h2 style="font-size:clamp(1.75rem,3.5vw,2.6rem);font-weight:900;letter-spacing:-1.2px;color:var(--text);">
            Everything you need.<br class="d-none d-sm-inline" /><span class="text-grad">Nothing you don't.</span>
        </h2>
    </div>

    <div class="bento-grid">
        <!-- Cell 1: Real-time -->
        <div class="bento-cell bento-1" style="background:linear-gradient(135deg,rgba(99,102,241,0.08) 0%, var(--surface) 60%);">
            <div class="bento-orb" style="width:200px;height:200px;background:rgba(99,102,241,0.1);top:-60px;right:-40px;"></div>
            <div class="bento-icon" style="background:rgba(99,102,241,0.12);border:1px solid rgba(99,102,241,0.2);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 style="font-size:1.15rem;font-weight:700;color:var(--text);margin-bottom:10px;">Real-time messaging</h3>
            <p style="font-size:0.87rem;color:var(--text-3);line-height:1.65;max-width:340px;">Messages delivered in under 50ms via WebSocket. Conversations flow without interruption — no refresh, ever.</p>
            <div style="margin-top:20px;display:flex;gap:6px;flex-wrap:wrap;">
                <span style="font-size:0.72rem;padding:3px 10px;border-radius:99px;background:rgba(99,102,241,0.12);color:#818cf8;border:1px solid rgba(99,102,241,0.2);">WebSocket</span>
                <span style="font-size:0.72rem;padding:3px 10px;border-radius:99px;background:rgba(99,102,241,0.12);color:#818cf8;border:1px solid rgba(99,102,241,0.2);">SignalR</span>
            </div>
        </div>

        <!-- Cell 2: Security -->
        <div class="bento-cell bento-2" style="background:linear-gradient(135deg,rgba(244,63,94,0.06) 0%, var(--surface) 60%);">
            <div class="bento-orb" style="width:180px;height:180px;background:rgba(244,63,94,0.08);bottom:-40px;left:-40px;"></div>
            <div class="bento-icon" style="background:rgba(244,63,94,0.1);border:1px solid rgba(244,63,94,0.18);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 style="font-size:1.15rem;font-weight:700;color:var(--text);margin-bottom:10px;">End-to-end secure</h3>
            <p style="font-size:0.87rem;color:var(--text-3);line-height:1.65;max-width:340px;">Enterprise-grade JWT authentication with secure cookies. Your data is yours — always encrypted, never sold.</p>
            <div style="margin-top:20px;display:flex;gap:6px;flex-wrap:wrap;">
                <span style="font-size:0.72rem;padding:3px 10px;border-radius:99px;background:rgba(244,63,94,0.1);color:#f43f5e;border:1px solid rgba(244,63,94,0.18);">JWT</span>
                <span style="font-size:0.72rem;padding:3px 10px;border-radius:99px;background:rgba(244,63,94,0.1);color:#f43f5e;border:1px solid rgba(244,63,94,0.18);">256-bit AES</span>
            </div>
        </div>

        <!-- Cell 3: Groups -->
        <div class="bento-cell bento-3" style="background:linear-gradient(160deg,rgba(34,211,238,0.06) 0%, var(--surface) 70%);">
            <div class="bento-icon" style="background:rgba(34,211,238,0.1);border:1px solid rgba(34,211,238,0.18);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22d3ee" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 style="font-size:1rem;font-weight:700;color:var(--text);margin-bottom:8px;">Groups & teams</h3>
            <p style="font-size:0.83rem;color:var(--text-3);line-height:1.6;">Unlimited groups with dynamic member management.</p>
        </div>

        <!-- Cell 4: Video -->
        <div class="bento-cell bento-4" style="background:linear-gradient(160deg,rgba(168,185,129,0.06) 0%, var(--surface) 70%);">
            <div class="bento-icon" style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.18);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            </div>
            <h3 style="font-size:1rem;font-weight:700;color:var(--text);margin-bottom:8px;">Video calls</h3>
            <p style="font-size:0.83rem;color:var(--text-3);line-height:1.6;">WebRTC-powered HD video — one click to connect.</p>
        </div>

        <!-- Cell 5: Files -->
        <div class="bento-cell bento-5" style="background:linear-gradient(160deg,rgba(245,158,11,0.06) 0%, var(--surface) 70%);">
            <div class="bento-icon" style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.18);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
            </div>
            <h3 style="font-size:1rem;font-weight:700;color:var(--text);margin-bottom:8px;">File sharing</h3>
            <p style="font-size:0.83rem;color:var(--text-3);line-height:1.6;">Images, docs, voice messages — all in one thread.</p>
        </div>

        <!-- Cell 6: Dark/Light mode highlight -->
        <div class="bento-cell bento-6" style="position:relative;overflow:hidden;">
            <div class="bento-orb" style="width:300px;height:300px;background:linear-gradient(135deg,rgba(99,102,241,0.12),rgba(34,211,238,0.08));top:-80px;right:-60px;"></div>
            <div class="row align-items-center h-100 g-4" style="position:relative;z-index:1;">
                <div class="col-lg-6">
                    <div class="bento-icon" style="background:linear-gradient(135deg,rgba(99,102,241,0.12),rgba(34,211,238,0.08));border:1px solid var(--border-2);margin-bottom:16px;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                    </div>
                    <h3 style="font-size:1.15rem;font-weight:700;color:var(--text);margin-bottom:10px;">Dark & Light mode</h3>
                    <p style="font-size:0.87rem;color:var(--text-3);line-height:1.65;">Seamlessly switch between dark and light themes. Your preference is saved and respected across sessions.</p>
                </div>
                <div class="col-lg-6 d-flex justify-content-center">
                    <!-- Toggle demo -->
                    <div style="display:flex;flex-direction:column;gap:10px;align-items:center;width:100%;max-width:200px;">
                        <div style="width:100%;background:var(--bg-2);border:1px solid var(--border-2);border-radius:12px;padding:12px;display:flex;align-items:center;gap:10px;">
                            <div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;font-size:0.7rem;color:#fff;font-weight:700;flex-shrink:0;">M</div>
                            <div style="min-width:0;">
                                <div style="font-size:0.75rem;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Dark mode</div>
                                <div style="font-size:0.68rem;color:var(--text-3);">Easier on eyes</div>
                            </div>
                        </div>
                        <button class="theme-toggle" data-theme-toggle aria-label="Switch theme" style="width:44px;height:44px;border-radius:12px;">
                            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                        </button>
                        <div style="width:100%;background:#f8faff;border:1px solid rgba(0,0,0,0.1);border-radius:12px;padding:12px;display:flex;align-items:center;gap:10px;">
                            <div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#4f46e5,#7c3aed);display:flex;align-items:center;justify-content:center;font-size:0.7rem;color:#fff;font-weight:700;flex-shrink:0;">M</div>
                            <div style="min-width:0;">
                                <div style="font-size:0.75rem;font-weight:600;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Light mode</div>
                                <div style="font-size:0.68rem;color:#64748b;">Crisp & clean</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cell 7: Notifications -->
        <div class="bento-cell bento-7" style="background:linear-gradient(160deg,rgba(168,85,247,0.07) 0%, var(--surface) 70%);">
            <div class="bento-icon" style="background:rgba(168,85,247,0.1);border:1px solid rgba(168,85,247,0.18);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </div>
            <h3 style="font-size:1rem;font-weight:700;color:var(--text);margin-bottom:8px;">Smart alerts</h3>
            <p style="font-size:0.83rem;color:var(--text-3);line-height:1.6;">Toast alerts, delivery receipts, online indicators.</p>
        </div>
    </div>
</section>

<!-- ════════════════ ABOUT SECTION ════════════════ -->
<section id="about" class="about-section">
    <div class="text-center mb-4 mb-sm-5">
        <div class="hero-badge mb-3 d-inline-flex">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            About MessageZ
        </div>
        <h2 style="font-size:clamp(1.75rem,3.5vw,2.5rem);font-weight:900;letter-spacing:-1.2px;color:var(--text);">
            Engineered for seamless,<br class="d-none d-sm-inline" /><span class="text-grad">boundary-free connection.</span>
        </h2>
        <p class="mx-auto mt-3" style="font-size:clamp(0.88rem, 2vw, 0.98rem);color:var(--text-3);max-width:620px;line-height:1.7;">
            MessageZ was built to eliminate the lag between thinking and sharing. Combining high-concurrency SignalR hubs with direct WebRTC peer-to-peer pipelines, we deliver a communication workspace that feels instantaneous.
        </p>
    </div>

    <div class="row g-3 g-md-4">
        <div class="col-12 col-md-4">
            <div class="about-card h-100">
                <div class="about-icon" style="background:rgba(99,102,241,0.12);color:var(--primary-2);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                </div>
                <h4 class="about-title">Instantaneous Sync</h4>
                <p class="about-text">Persistent bi-directional WebSocket connections ensure message dispatch, presence updates, and read receipts synchronize across all devices with sub-50ms latency.</p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="about-card h-100">
                <div class="about-icon" style="background:rgba(16,185,129,0.12);color:#10b981;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <h4 class="about-title">Privacy-First Architecture</h4>
                <p class="about-text">Every communication channel is fortified with JWT token auth and end-to-end data sanitization, ensuring user identity and conversation privacy remain fully protected.</p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="about-card h-100">
                <div class="about-icon" style="background:rgba(34,211,238,0.12);color:#22d3ee;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                </div>
                <h4 class="about-title">Adaptive Experience</h4>
                <p class="about-text">Crafted from the ground up to adapt effortlessly from desktop workstations to tablets and smartphones, complete with true dark and light high-contrast themes.</p>
            </div>
        </div>
    </div>
</section>

<!-- ════════════════ CTA ════════════════ -->
<section style="padding:20px 0 clamp(48px, 8vw, 90px);">
    <div class="card text-center cta-card" style="border-radius:24px;padding:clamp(40px, 6vw, 64px) clamp(20px, 4vw, 32px);background:linear-gradient(140deg,rgba(99,102,241,0.06) 0%,var(--surface) 50%,rgba(34,211,238,0.04) 100%);border:1px solid var(--border-2);position:relative;overflow:hidden;">
        <div class="bento-orb" style="width:300px;height:300px;background:rgba(99,102,241,0.1);top:-80px;left:-60px;"></div>
        <div class="bento-orb" style="width:280px;height:280px;background:rgba(34,211,238,0.06);bottom:-70px;right:-50px;"></div>
        <div style="position:relative;z-index:1;">
            <div class="hero-badge mb-3 mb-sm-4 d-inline-flex">✨ Free forever — no credit card needed</div>
