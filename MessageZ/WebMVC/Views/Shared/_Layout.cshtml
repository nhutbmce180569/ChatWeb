<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MessageZ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tech-theme.css" asp-append-version="true" />
    <!-- Apply theme BEFORE render to avoid flash -->
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- ── NAVBAR ── -->
<nav class="mz-nav">
    <div class="mz-nav-container">
        <a class="mz-nav-brand" asp-controller="Home" asp-action="Index">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span>MessageZ</span>
        </a>

        <ul class="mz-nav-links d-none d-md-flex">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-controller="Chat" asp-action="Index">Chat</a></li>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <li><a asp-controller="Profile" asp-action="Index">Profile</a></li>
            }
            <li><a href="#features">Features</a></li>
            <li><a href="#about">About</a></li>
        </ul>

        <div class="mz-nav-actions">
            <!-- Theme toggle -->
            <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme" title="Toggle theme">
                <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
                <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                    <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                </svg>
            </button>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                var headerAvatar = User.FindFirst("AvatarUrl")?.Value;
                var headerName = User.FindFirst("DisplayName")?.Value ?? User.Identity.Name ?? "User";
                var headerInitial = !string.IsNullOrEmpty(headerName) ? headerName.Substring(0, 1).ToUpper() : "U";

                <a asp-controller="Profile" asp-action="Index" class="btn-nav-ghost d-none d-sm-inline-flex" title="My Profile">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    <span>Profile</span>
                </a>
                <a asp-controller="Profile" asp-action="Index" class="mz-user-chip text-decoration-none" title="View Profile (@headerName)">
                    <div class="avatar-xs">
                        @if (!string.IsNullOrEmpty(headerAvatar))
                        {
                            <img src="@headerAvatar" alt="@headerName" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
                        }
                        else
                        {
                            <span>@headerInitial</span>
                        }
                    </div>
                    <span class="d-none d-sm-inline">@headerName</span>
                </a>
                <form class="m-0 d-none d-sm-block" asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="btn-nav-ghost" title="Sign out">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                        <span>Sign out</span>
                    </button>
                </form>
            }
            else
            {
                <a class="btn-nav-ghost d-none d-sm-inline-flex" asp-controller="Auth" asp-action="Login">Sign in</a>
                <a class="btn-nav-primary" asp-controller="Auth" asp-action="Register">
                    <span>Get started</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            }

            <!-- Mobile Hamburger Toggle -->
            <button class="mz-nav-toggle d-md-none" id="mzNavToggle" aria-label="Toggle navigation" aria-expanded="false" type="button">
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
            </button>
        </div>
    </div>
</nav>

<!-- Mobile Menu Overlay & Drawer -->
<div class="mz-mobile-backdrop" id="mzMobileBackdrop"></div>
<div class="mz-mobile-menu" id="mzMobileMenu" aria-hidden="true">
    <div class="mz-mobile-menu-inner">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            var mAvatar = User.FindFirst("AvatarUrl")?.Value;
            var mName = User.FindFirst("DisplayName")?.Value ?? User.Identity.Name ?? "User";
            var mInitial = !string.IsNullOrEmpty(mName) ? mName.Substring(0, 1).ToUpper() : "U";

            <div class="mz-mobile-user-card">
                <div class="mz-mobile-avatar">
                    @if (!string.IsNullOrEmpty(mAvatar))
                    {
                        <img src="@mAvatar" alt="@mName" />
                    }
                    else
                    {
                        <span>@mInitial</span>
                    }
                </div>
                <div class="mz-mobile-user-info">
                    <div class="mz-mobile-username">@mName</div>
                    <div class="mz-mobile-userstatus">
                        <span class="online-indicator"></span> Online
                    </div>
                </div>
                <a asp-controller="Profile" asp-action="Index" class="btn-profile-badge" title="Edit Profile">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </a>
            </div>
        }

        <ul class="mz-mobile-links">
            <li>
                <a asp-controller="Home" asp-action="Index" class="mz-mobile-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    <span>Home</span>
                </a>
            </li>
            <li>
                <a asp-controller="Chat" asp-action="Index" class="mz-mobile-link highlight-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    <span>Chat Messenger</span>
                    <span class="badge-new">Live</span>
                </a>
            </li>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <li>
                    <a asp-controller="Profile" asp-action="Index" class="mz-mobile-link">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <span>My Profile</span>
                    </a>
                </li>
            }
            <li>
                <a href="#features" class="mz-mobile-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <span>Features</span>
                </a>
            </li>
            <li>
                <a href="#about" class="mz-mobile-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                    <span>About MessageZ</span>
                </a>
            </li>
        </ul>

        <div class="mz-mobile-actions">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <form class="w-100 m-0" asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="btn-logout-mobile w-100">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        <span>Sign out</span>
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Register" class="btn-primary w-100 justify-content-center mb-2">
                    Get started free
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
                <a asp-controller="Auth" asp-action="Login" class="btn-ghost w-100 justify-content-center">
                    Sign in to account
                </a>
            }
        </div>
    </div>
</div>

<!-- ── MAIN ── -->
<main class="mz-main-content">
    <div class="container mz-main-container">
        @RenderBody()
    </div>
</main>

<!-- ── FOOTER ── -->
<footer class="mz-footer">
    <div class="container mz-main-container">
        <div class="row g-4 mb-4">
            <!-- Brand & Mission -->
            <div class="col-12 col-md-5">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="mz-footer-logo-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                    </div>
                    <span class="mz-footer-brand-name">MessageZ</span>
                </div>
                <p class="mz-footer-desc mb-3">
                    A next-generation real-time messaging and collaboration platform. Engineered for ultra-low latency, crystal-clear WebRTC video calls, and seamless encrypted conversations.
                </p>
                <div class="d-inline-flex align-items-center gap-2 mz-system-status">
                    <span class="status-pulse"></span>
                    <span>All systems operational</span>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="col-6 col-sm-4 col-md-2 offset-md-1">
                <div class="mz-footer-heading">Product</div>
                <ul class="mz-footer-links">
                    <li><a asp-controller="Chat" asp-action="Index">Chat App</a></li>
                    <li><a href="#features">Features</a></li>
                    <li><a href="#about">About</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                </ul>
            </div>

            <!-- Platform / Tech -->
            <div class="col-6 col-sm-4 col-md-2">
                <div class="mz-footer-heading">Platform</div>
                <ul class="mz-footer-links">
                    <li><a href="#features">SignalR WebSockets</a></li>
                    <li><a href="#features">WebRTC Video</a></li>
                    <li><a href="#features">JWT Encryption</a></li>
                    <li><a href="#features">Dark & Light Mode</a></li>
                </ul>
            </div>

            <!-- Account / Connect -->
            <div class="col-12 col-sm-4 col-md-2">
                <div class="mz-footer-heading">Account</div>
                <ul class="mz-footer-links">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li><a asp-controller="Profile" asp-action="Index">My Profile</a></li>
                        <li><a asp-controller="Chat" asp-action="Index">Inbox</a></li>
                    }
                    else
                    {
                        <li><a asp-controller="Auth" asp-action="Login">Sign In</a></li>
                        <li><a asp-controller="Auth" asp-action="Register">Create Account</a></li>
                    }
                    <li><a href="mailto:support@messagez.local">Contact Support</a></li>
                </ul>
            </div>
        </div>

        <div class="mz-footer-bottom pt-4 border-top">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 text-center text-sm-start">
                <p class="mb-0 mz-copyright">
                    © 2026 MessageZ · Built for the speed of thought. All rights reserved.
                </p>
                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="mz-footer-sublink">Privacy</a>
                    <span class="dot-sep">·</span>
                    <a href="#features" class="mz-footer-sublink">Terms</a>
                    <span class="dot-sep">·</span>
                    <button type="button" class="mz-back-to-top" id="backToTopBtn" aria-label="Back to top" title="Back to top">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="18 15 12 9 6 15"/>
                        </svg>
                        <span>Top</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</footer>

<!-- Toast -->
<div id="toast-container" class="toast-container position-fixed top-0 end-0 p-4" style="z-index:2000;"></div>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <partial name="_CallModal" />
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/toast-notification.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        @if (TempData["SuccessMessage"] != null) { <text>showToast('@Html.Raw(TempData["SuccessMessage"])', 'success');</text> }
        @if (TempData["ErrorMessage"]   != null) { <text>showToast('@Html.Raw(TempData["ErrorMessage"])',   'error');</text>   }
    });
</script>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <script>
        window.appData = {
            token: '@User.FindFirst("Token")?.Value',
            userId: '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value',
            displayName: '@Html.Raw(User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "User")',
            apiBaseUrl: '@(Configuration["WebAPI:BaseUrl"] ?? Configuration.GetConnectionString("WebAPI") ?? "http://localhost:7088")'
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/webrtc.js" asp-append-version="true"></script>
    <script src="~/js/global-signalr.js" asp-append-version="true"></script>
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
