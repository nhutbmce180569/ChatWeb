<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tech-theme.css" asp-append-version="true" />
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body style="overflow:hidden;">

<!-- ── Chat Navbar ── -->
<nav class="mz-nav" style="height:52px;padding:0;">
    <div style="width:100%;padding:0 clamp(12px, 3vw, 20px);display:flex;align-items:center;justify-content:space-between;">
        <a class="mz-nav-brand" asp-controller="Home" asp-action="Index" style="font-size:1.08rem;gap:8px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span>MessageZ</span>
        </a>

        <div class="mz-nav-actions" style="gap:8px;">
            <!-- Theme toggle -->
            <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme" title="Toggle theme">
                <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
                <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                    <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                </svg>
            </button>

            @{
                var chatAvatar = User.FindFirst("AvatarUrl")?.Value;
                var chatName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "User";
                var chatInitial = !string.IsNullOrEmpty(chatName) ? chatName.Substring(0, 1).ToUpper() : "U";
            }

            @if (User.IsInRole("Admin"))
            {
                <!-- Admin Dashboard (Admin only) -->
                <a asp-controller="Admin" asp-action="Dashboard" class="btn-nav-ghost d-none d-sm-inline-flex align-items-center gap-1" title="Admin Dashboard" style="font-size:0.82rem;padding:5px 10px;color:#a5b4fc;border:1px solid rgba(165,180,252,0.3);">
                    <span>👑 Admin</span>
                </a>
            }

            <!-- Profile button (desktop only) -->
            <a asp-controller="Profile" asp-action="Index" class="btn-nav-ghost d-none d-md-inline-flex" title="My Profile" style="font-size:0.82rem;padding:5px 12px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <span>Profile</span>
            </a>

            <!-- User chip (avatar + optional name) -->
            <a asp-controller="Profile" asp-action="Index" class="mz-user-chip text-decoration-none" title="View Profile (@chatName)">
                <div class="avatar-xs">
                    @if (!string.IsNullOrEmpty(chatAvatar))
                    {
                        <img src="@chatAvatar" alt="@chatName" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
                    }
                    else
                    {
                        <span>@chatInitial</span>
                    }
                </div>
                <span class="d-none d-sm-inline">@chatName</span>
            </a>

            <!-- Sign out -->
            <form class="m-0" asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="btn-icon" title="Sign out">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</nav>

@RenderBody()

<!-- Toast -->
<div id="toast-container" class="toast-container position-fixed top-0 end-0 p-4" style="z-index:2000;"></div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/toast-notification.js" asp-append-version="true"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        @if (TempData["SuccessMessage"] != null) { <text>showToast('@Html.Raw(TempData["SuccessMessage"])', 'success');</text> }
        @if (TempData["ErrorMessage"]   != null) { <text>showToast('@Html.Raw(TempData["ErrorMessage"])',   'error');</text>   }
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
